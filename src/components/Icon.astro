export type IconName = keyof typeof icons;

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  label?: string;
}

const { name, size = 24, strokeWidth = 1.5, class: className, label } = Astro.props;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const, focusable: 'false' as const };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', className]}
  {...a11y}
  set:html={icons[name]}
/>
