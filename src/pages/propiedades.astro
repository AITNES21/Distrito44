---
/**
 * Página de paso hacia el catálogo de Idealista.
 *
 * Motivo: en iPhone con la app de Idealista instalada, pulsar un enlace
 * directo a idealista.com abre la app (enlace universal de iOS) y la app
 * muestra la página de agencia en blanco. Si la navegación hacia Idealista
 * la inicia una redirección (no un toque del usuario), iOS la mantiene en
 * Safari, donde se ve bien.
 *
 * No se indexa ni aparece en el sitemap. Incluye enlace de respaldo.
 */
import '@fontsource/poppins/latin-500.css';
import '@fontsource-variable/inter/index.css';
import '../styles/global.css';
import { propertiesUrl, site } from '../data/site';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta http-equiv="refresh" content={`0;url=${propertiesUrl}`} />
    <title>Nuestras propiedades | {site.name}</title>
    <link rel="canonical" href={propertiesUrl} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
  </head>
  <body>
    <main class="go">
      <img src="/img/logo2.webp" alt="" width="72" height="72" class="go__logo" />
      <p class="go__title">Te llevamos a nuestras propiedades en Idealista…</p>
      <p><a href={propertiesUrl}>Si no se abre automáticamente, pulsa aquí</a></p>
      <p><a href="/">Volver a la web de Distrito 44</a></p>
    </main>
  </body>
</html>

<style>
  .go {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
  }
  .go__logo {
    border-radius: 50%;
    margin-bottom: 0.5rem;
  }
  .go__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    color: var(--d44-ink);
  }
</style>
