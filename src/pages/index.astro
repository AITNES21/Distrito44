---
import { Picture } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import OrganicLines from '../components/OrganicLines.astro';
import Shape from '../components/Shape.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import { propertiesUrl } from '../data/site';
import { realEstateAgent, organization, website } from '../data/schema';

import heroImg from '../assets/img/ft1.webp';
import terracesImg from '../assets/img/ft3.webp';
import interiorImg from '../assets/img/gl4.avif';

const features: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'graduation-cap',
    title: 'Equipo con experiencia',
    text: 'Nuestro equipo está formado por expertos especializados en el sector inmobiliario con años de experiencia. Aportamos seguridad, tranquilidad y resultados excepcionales, garantizando una gestión profesional de principio a fin.',
  },
  {
    icon: 'map',
    title: 'Buscamos al comprador por usted',
    text: 'Nos ocupamos de todas las gestiones necesarias para encontrar al comprador ideal. Ofrecemos un servicio financiero aplicable que incluye todas las herramientas y asesoramiento hasta lograr la venta de su propiedad con éxito.',
  },
  {
    icon: 'thumbs-up',
    title: 'Calidad garantizada',
    text: 'Nuestra experiencia nos avala. Proporcionamos plena dedicación para asegurar la satisfacción del vendedor y comprador, trabajando correctamente desde el primer contacto hasta el cierre de la operación con total profesionalidad.',
  },
];

const leafTones = ['', 'leaf--peach leaf--flip', 'leaf--green'];

const stats = [
  { value: 1632, label: 'Clientes Satisfechos' },
  { value: 1, label: 'Ubicación' },
  { value: 3, label: 'Personal Profesional' },
  { value: 12, label: 'Años de Experiencia' },
];
---

<MainLayout
  title="Distrito 44 | Inmobiliaria en Madrid - Venta y Alquiler de Pisos"
  description="Inmobiliaria en Madrid con 12 años de experiencia. Venta y alquiler de pisos en Arroyomolinos. Valoración gratuita, asesoría profesional. ¡Contáctanos!"
  path="/"
  ogDescription="Inmobiliaria en Madrid con 12 años de experiencia. Venta y alquiler de pisos en Arroyomolinos. Valoración gratuita."
  twitterTitle="Distrito 44 | Inmobiliaria en Madrid"
  twitterDescription="Inmobiliaria en Madrid con 12 años de experiencia. Venta y alquiler de pisos en Arroyomolinos."
  ogImage="/img/ft1.webp"
  geo
  jsonLd={[realEstateAgent, organization, website]}
>
  <!-- ================= HERO ================= -->
  <section class="hero" aria-labelledby="hero-title">
    <OrganicLines variant="terraces" draw lines={12} class="hero__lines" />

    <div class="container container--wide hero__grid">
      <div class="hero__text">
        <h1 id="hero-title" class="hero__title hero-fade">
          <span class="hero__distrito">Distrito</span>
          <span class="hero__num">44</span><span class="sr-only"> - Inmobiliaria en Madrid</span>
        </h1>
        <p class="hero__tagline hero-fade" style="--d:140ms">HACEMOS SUEÑOS REALIDAD</p>
        <div class="hero__actions hero-fade" style="--d:260ms">
          <Button href={propertiesUrl}>Nuestras propiedades</Button>
          <Button href="/contacto.html" variant="outline">Contáctanos</Button>
        </div>
      </div>

      <figure class="hero__media hero-fade" style="--d:60ms">
        <Picture
          src={heroImg}
          alt="Edificio residencial moderno en Madrid - Distrito 44 Inmobiliaria"
          widths={[480, 720, 960, 1248]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          loading="eager"
          priority
          class="hero__img"
        />
      </figure>
    </div>
  </section>

  <!-- ================= CARACTERÍSTICAS ================= -->
  <section class="section features" aria-label="Por qué Distrito 44">
    <Shape kind="pebble" tone="peach" class="features__pebble" />
    <Shape kind="ring" tone="logo" class="features__ring" />
    <div class="container features__grid">
      <div class="features__media" data-reveal>
        <Shape kind="arch" tone="peach" class="features__arch-line" />
        <div class="features__frame">
          <Picture
            src={terracesImg}
            alt="Paisaje de terrazas verdes entre montañas"
            widths={[420, 640, 900]}
            sizes="(min-width: 960px) 34vw, 100vw"
            formats={['avif']}
            fallbackFormat="webp"
            class="features__img"
          />
        </div>
        <Shape kind="circle" tone="green" class="features__dot" />
      </div>

      <ol role="list" class="features__list">
        {
          features.map((f, i) => (
            <li class:list={['feature', 'leaf', leafTones[i]]} data-reveal style={`--reveal-delay:${i * 90}ms`}>
              <span class="leaf__numeral index-number--desktop" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="arch-badge"><Icon name={f.icon} size={22} /></span>
              <h2 class="feature__title">{f.title}</h2>
              <p>{f.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ================= SERVICIOS PROFESIONALES ================= -->
  <section class="section services surface-white" aria-labelledby="services-title">
    <OrganicLines variant="origami" class="services__lines" />
    <div class="container services__grid">
      <div class="services__intro">
        <SectionHeading
          id="services-title"
          title="Nuestros Servicios Profesionales"
          subtitle="Experiencia y dedicación en cada operación"
        />
        <div class="services__more services__more--desktop" data-reveal><Button href="/nuestros-servicios.html" variant="link">Nuestros Servicios</Button></div>
        <figure class="services__media" data-reveal>
          <Shape kind="halfring" tone="peach" class="services__halfring" />
          <div class="services__frame">
            <Picture
              src={interiorImg}
              alt="Salón luminoso de un dúplex con escalera"
              widths={[360, 540, 760]}
              sizes="30vw"
              formats={['avif']}
              fallbackFormat="webp"
              class="services__img"
            />
          </div>
          <Shape kind="circle" tone="blue" class="services__dot" />
        </figure>
      </div>

      <div class="services__list">
        <article class="service" data-reveal>
          <h3><Icon name="trending-up" size={22} /> Asesoría Profesional</h3>
          <p>
            Confíe en nuestros métodos profesionales a la hora de vender su casa. Garantizamos tasar su propiedad
            adecuadamente, basándonos en nuestros recientes estudios del mercado, en las valoraciones obtenidas a través
            del Colegio de Registradores de España y las casas vendidas en los últimos meses con las mismas
            características, situación, estado y métrica. Le ayudaremos a conseguir el máximo beneficio posible de su
            propiedad.
          </p>
        </article>

        <article class="service" data-reveal>
          <h3><Icon name="megaphone" size={22} /> Exposición y Publicación</h3>
          <p>
            Trabajamos arduamente para asegurar la completa exposición de nuestras propiedades listadas, publicitándolas
            en todos los portales de internet y otros medios adicionales, llegando a miles de compradores potenciales.
          </p>
        </article>

        <article class="service" data-reveal>
          <h3><Icon name="sofa" size={22} /> Preparación y Fotografía</h3>
          <p>
            Le mostraremos cómo preparar adecuadamente su casa para mostrarla a los compradores potenciales,
            asesorándole en todo momento durante el proceso de venta.
          </p>
          <p>
            Ofrecemos el servicio de Home Staging o estrategia de marketing inmobiliario para preparar la propiedad y
            favorecer, agilizar de este modo, la operación inmobiliaria.
          </p>
        </article>

        <article class="service" data-reveal>
          <h3><Icon name="users" size={22} /> Venta Personalizada</h3>
          <ul class="tick-list">
            <li>
              Organizamos visitas guiadas a la zona donde se encuentra la vivienda, ofreciendo información adicional y
              mostrando al comprador por qué debe elegir esa casa y no otra.
            </li>
            <li>
              Realizamos un filtrado previo de clientes potenciales para que las visitas sean realmente interesantes,
              conociendo la solvencia de los compradores y evitando perder el tiempo.
            </li>
          </ul>
        </article>
      </div>
      <div class="services__more services__more--mobile"><Button href="/nuestros-servicios.html" variant="link">Nuestros Servicios</Button></div>
    </div>
  </section>

  <!-- ================= TRAYECTORIA ================= -->
  <section class="stats" aria-labelledby="stats-title">
    <OrganicLines variant="terraces" lines={10} class="stats__lines" flip />
    <Shape kind="pebble" tone="white" class="stats__pebble" />
    <Shape kind="halfring" tone="peach" class="stats__halfring" />
    <div class="container">
      <SectionHeading
        id="stats-title"
        tone="light"
        title="Nuestra Trayectoria en Números"
        subtitle="Años de experiencia que nos respaldan"
      />
      <dl class="stats__grid">
        {
          stats.map((s, i) => (
            <div class="stat" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <Shape kind="halfring" tone="peach" class="stat__ring" />
              <dt class="stat__label">{s.label}</dt>
              <dd class="stat__value" data-count={s.value}>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand
    title="¿Quieres Valorar Tu Propiedad?"
    text="Obtén una valoración profesional y gratuita de tu inmueble. Nuestros expertos te asesorarán sin compromiso."
    cta="Solicitar Valoración Gratuita"
  />
</MainLayout>

<script>
  // Contador: el número final ya está en el HTML (SEO y sin JS).
  // Solo se anima si el usuario no ha pedido reducir el movimiento.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const els = document.querySelectorAll<HTMLElement>('[data-count]');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          io.unobserve(el);
          const target = Number(el.dataset.count);
          const start = performance.now();
          const dur = 1600;
          const tick = (now: number) => {
            const p = Math.min((now - start) / dur, 1);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = String(Math.round(target * eased));
            if (p < 1) requestAnimationFrame(tick);
          };
          el.textContent = '0';
          requestAnimationFrame(tick);
        }
      },
      { threshold: 0.6 },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(3rem, 2rem + 5vw, 7rem);
  }
  @media (max-width: 759px) {
    .hero {
      padding-block: 1.5rem 0;
    }
  }
  .hero :global(.hero__lines) {
    inset: 8% -5% 0 -5%;
    width: 110%;
    height: 92%;
    opacity: 0.5;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-lg);
    align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
      min-height: min(78vh, 820px);
    }
  }
  .hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.25em;
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .hero__distrito {
    color: var(--d44-blue-logo);
  }
  .hero__num {
    color: var(--d44-peach);
    font-weight: 300;
  }
  .hero__tagline {
    margin-top: var(--space-md);
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 0.85rem + 0.5vw, 1.2rem);
    font-weight: 400;
    letter-spacing: 0.32em;
    color: var(--d44-ink);
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  @media (max-width: 480px) {
    .hero__tagline {
      letter-spacing: 0.2em;
    }
  }
  .hero__tagline::before {
    content: '';
    width: 3rem;
    height: 2px;
    background: var(--d44-peach);
    flex-shrink: 0;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-lg);
  }
  @media (max-width: 559px) {
    .hero__actions {
      display: grid;
    }
  }
  .hero__media {
    position: relative;
    aspect-ratio: 4 / 3.4;
    border-radius: var(--radius-arch);
    overflow: hidden;
    background: var(--d44-mist-2);
  }
  @media (min-width: 1024px) {
    .hero__media {
      aspect-ratio: 4 / 4.4;
      max-height: 78vh;
      justify-self: end;
      width: 100%;
    }
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Características ---------- */
  .features {
    position: relative;
    overflow: hidden;
  }
  .features :global(.features__pebble) {
    width: min(78vw, 780px);
    left: -22%;
    top: 4%;
    opacity: 0.28;
  }
  .features :global(.features__ring) {
    width: 280px;
    right: -110px;
    bottom: 8%;
    opacity: 0.45;
  }
  .features__grid {
    position: relative;
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 960px) {
    .features__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--space-2xl);
      align-items: start;
    }
    .features__media {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
    }
  }
  /* En móvil la foto del hero y la de terrazas quedaban seguidas: se omite esta */
  @media (max-width: 959px) {
    .features__media {
      display: none;
    }
  }
  .features__media {
    position: relative;
    margin: 1.5rem 1.5rem 0 1.5rem;
  }
  .features__frame {
    position: relative;
    aspect-ratio: 3 / 3.9;
    border-radius: var(--radius-arch);
    overflow: hidden;
    background: var(--d44-mist-2);
  }
  .features__frame :global(.features__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .features__media :global(.features__arch-line) {
    left: -1.25rem;
    top: -1.25rem;
    width: calc(100% + 2.5rem);
    height: calc(100% + 1.25rem);
    opacity: 0.9;
  }
  .features__media :global(.features__dot) {
    width: 7.5rem;
    left: -2.5rem;
    bottom: -2rem;
    opacity: 0.55;
  }
  .features__list {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 960px) {
    .feature:nth-child(odd) {
      margin-right: 3rem;
    }
    .feature:nth-child(even) {
      margin-left: 3rem;
    }
  }
  .feature__title {
    font-size: var(--fs-h3);
    margin: 1.1rem 0 0.6rem;
    max-width: 22ch;
  }
  .feature p {
    max-width: 36rem;
  }

  /* ---------- Servicios ---------- */
  .services {
    overflow: hidden;
  }
  .services :global(.services__lines) {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--d44-blue);
    opacity: 0.22;
  }
  .services__grid {
    position: relative;
    display: grid;
    gap: var(--space-lg);
  }
  @media (min-width: 960px) {
    .services__grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--space-2xl);
    }
    .services__intro {
      position: sticky;
      top: calc(var(--header-h) + 3rem);
      align-self: start;
    }
  }
  .services__more--mobile {
    padding-top: var(--space-md);
    border-top: 1px solid var(--d44-line);
  }
  @media (max-width: 959px) {
    .services__more--desktop {
      display: none;
    }
    .services__grid :global(.section-heading) {
      margin-bottom: 0;
    }
  }
  @media (min-width: 960px) {
    .services__more--mobile {
      display: none;
    }
  }
  .services__list {
    display: grid;
    gap: 0;
  }
  .service {
    padding-block: var(--space-lg);
    border-top: 1px solid var(--d44-line);
    display: grid;
    gap: 1rem;
  }
  .service h3 {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .service h3 :global(.icon) {
    box-sizing: border-box;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.6rem;
    flex-shrink: 0;
    border-radius: 50%;
    color: var(--d44-peach-ink);
    background: var(--d44-tint-peach);
  }
  .service:nth-child(2) h3 :global(.icon) {
    color: var(--d44-blue-deep);
    background: var(--d44-tint-blue);
  }
  .service:nth-child(3) h3 :global(.icon) {
    color: var(--d44-green-ink);
    background: var(--d44-tint-green);
  }
  /* Foto en arco bajo el título (solo escritorio, para no apilar fotos en móvil) */
  .services__media {
    display: none;
  }
  @media (min-width: 960px) {
    .services__media {
      position: relative;
      display: block;
      width: min(100%, 22rem);
      margin: var(--space-xl) 0 0 2rem;
    }
  }
  .services__frame {
    position: relative;
    aspect-ratio: 3 / 3.8;
    border-radius: var(--radius-arch);
    overflow: hidden;
    background: var(--d44-mist-2);
  }
  .services__frame :global(.services__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .services__media :global(.services__halfring) {
    width: 150%;
    left: -25%;
    top: -14%;
    opacity: 0.8;
  }
  .services__media :global(.services__dot) {
    width: 4.5rem;
    right: -1.5rem;
    bottom: 12%;
    opacity: 0.35;
  }

  /* ---------- Trayectoria ---------- */
  .stats {
    position: relative;
    overflow: hidden;
    background: var(--d44-blue-ink);
    color: var(--d44-white);
    padding-block: var(--space-2xl);
  }
  .stats :global(.stats__lines) {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--d44-white);
    opacity: 0.1;
  }
  .stats .container {
    position: relative;
  }
  .stats :global(.stats__pebble) {
    width: min(60vw, 620px);
    right: -14%;
    top: -18%;
    opacity: 0.05;
  }
  .stats :global(.stats__halfring) {
    width: 240px;
    left: -80px;
    bottom: -2px;
    opacity: 0.35;
  }
  .stat {
    position: relative;
  }
  /* Arco del logotipo sobre cada cifra */
  .stat :global(.stat__ring) {
    width: 4.5rem;
    left: 0;
    top: calc(var(--space-lg) - 1.6rem);
    opacity: 0.6;
  }
  @media (min-width: 900px) {
    .stat:not(:first-child) :global(.stat__ring) {
      left: var(--space-md);
    }
  }
  @media (max-width: 759px) {
    .stats :global(.stats__halfring),
    .features :global(.features__ring) {
      display: none;
    }
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid rgb(255 255 255 / 0.2);
  }
  @media (min-width: 900px) {
    .stats__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: calc(var(--space-lg) + 1rem) var(--space-sm) var(--space-md) 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.2);
  }
  @media (min-width: 900px) {
    .stat {
      border-bottom: 0;
      padding-left: var(--space-md);
      border-left: 1px solid rgb(255 255 255 / 0.2);
    }
    .stat:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }
  .stat__value {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 2rem + 4vw, 5.5rem);
    font-weight: 300;
    line-height: 1;
    color: var(--d44-peach);
    font-variant-numeric: tabular-nums;
    margin: 0;
  }
  .stat__label {
    font-size: var(--fs-base);
    color: rgb(255 255 255 / 0.88);
  }
</style>
