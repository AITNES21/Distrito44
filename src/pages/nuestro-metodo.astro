---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import OrganicLines from '../components/OrganicLines.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';

/*
 * En la web original esta página repetía el H1 y el subtítulo de "Nuestros
 * Servicios" y el botón "Conoce Nuestro Método" enlazaba a sí misma. Corregido
 * a petición del cliente (títulos repetidos): H1 propio, subtítulo tomado de
 * la descripción original de la página y sin el botón autorreferente.
 */
const steps: { icon: IconName; title: string; text: string; list: string[] }[] = [
  {
    icon: 'calculator',
    title: 'Valoración Profesional',
    text: 'Valoración gratuita y profesional de tu inmueble con análisis detallado del mercado actual.',
    list: ['Estudio de mercado completo', 'Comparativa con propiedades similares', 'Informe detallado', 'Asesoramiento personalizado'],
  },
  {
    icon: 'megaphone',
    title: 'Marketing y Promoción',
    text: 'Máxima visibilidad para tu propiedad con las mejores herramientas de marketing digital.',
    list: ['Fotografía profesional', 'Publicación en portales líderes', 'Promoción en redes sociales'],
  },
  {
    icon: 'users',
    title: 'Visitas Guiadas',
    text: 'Organizamos y acompañamos cada visita para presentar tu propiedad de la mejor manera.',
    list: ['Organización completa', 'Filtrado de clientes potenciales', 'Acompañamiento profesional', 'Seguimiento post-visita'],
  },
  {
    icon: 'file-text',
    title: 'Gestión Legal',
    text: 'Asesoramiento jurídico completo para garantizar la seguridad de tu operación.',
    list: ['Revisión de documentación', 'Asesoramiento jurídico', 'Tramitación de papeleos', 'Garantía legal'],
  },
  {
    icon: 'key',
    title: 'Gestión de Alquiler',
    text: 'Servicio integral de gestión para propietarios e inquilinos de alquiler.',
    list: ['Búsqueda de inquilinos', 'Gestión de contratos', 'Seguro de impagos', 'Filtrado de demanda'],
  },
];

const extras: { icon: IconName; title: string; text: string }[] = [
  { icon: 'trending-up', title: 'Análisis de Mercado', text: 'Estudios detallados de tendencias y precios del mercado inmobiliario para tomar las mejores decisiones.' },
  { icon: 'handshake', title: 'Negociación Experta', text: 'Negociamos en tu nombre para conseguir el mejor precio y condiciones en la operación.' },
  { icon: 'clipboard-check', title: 'Certificados Energéticos', text: 'Tramitamos el certificado energético obligatorio para la venta o alquiler de tu propiedad.' },
  { icon: 'shield-check', title: 'Seguro de Hogar', text: 'Te ayudamos a contratar el mejor seguro de hogar adaptado a las necesidades de tu propiedad.' },
];
---

<MainLayout
  title="Nuestro Método de Venta | Proceso Profesional Inmobiliario - Distrito 44"
  description="Método profesional de venta inmobiliaria: estudio de mercado, valoración Colegio Registradores, filtrado de compradores. Máximo beneficio garantizado."
  path="/nuestro-metodo.html"
  ogTitle="Nuestro Método de Venta | Distrito 44"
  ogDescription="Método profesional garantizado para vender tu vivienda en Madrid con el máximo beneficio."
  twitterTitle="Nuestro Método | Distrito 44"
  ogImage="/img/ft1.webp"
  crumbs={[{ name: 'Nuestro Método', path: '/nuestro-metodo.html' }]}
>
  <PageHero
    crumb="Nuestro Método"
    title="Nuestro Método"
    subtitle="Método profesional garantizado para vender tu vivienda en Madrid con el máximo beneficio."
    lines="terraces"
  />

  <!-- PASOS -->
  <section class="section method" aria-label="Fases del método">
    <div class="container">
      <ol role="list" class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal>
              <div class="step__marker">
                <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="step__head">
                <h2 class="step__title">
                  <Icon name={s.icon} size={24} /> {s.title}
                </h2>
                <p>{s.text}</p>
              </div>
              <ul class="tick-list step__list">
                {s.list.map((item) => <li>{item}</li>)}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ADICIONALES -->
  <section class="section extras surface-white" aria-labelledby="extras-title">
    <OrganicLines variant="origami" class="extras__lines" />
    <div class="container">
      <SectionHeading
        id="extras-title"
        title="Servicios Adicionales"
        subtitle="Más soluciones para completar tu experiencia inmobiliaria"
      />
      <ul role="list" class="extras__grid">
        {
          extras.map((e, i) => (
            <li class="extra" data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
              <h3><Icon name={e.icon} size={22} /> {e.title}</h3>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS -->
  <section class="section how" aria-labelledby="how-title">
    <OrganicLines variant="orbit" lines={8} class="how__orbit" />
    <div class="container how__inner" data-reveal>
      <SectionHeading
        id="how-title"
        align="center"
        title="¿Cómo Trabajamos?"
        subtitle="Nuestro proceso garantiza los mejores resultados"
      />
      <p class="lead how__text">
        Combinamos todos nuestros servicios de forma coordinada para ofrecerte una experiencia integral. Desde la primera
        valoración hasta la entrega de llaves, nuestro equipo trabaja contigo en cada paso del camino.
      </p>
    </div>
  </section>

  <CtaBand
    title="¿Necesitas Más Información?"
    text="Contáctanos y te asesoraremos sin compromiso sobre el mejor servicio para ti"
    cta="Contactar Ahora"
  />
</MainLayout>

<style>
  /* Pasos: línea vertical continua que une las fases */
  .steps {
    position: relative;
    display: grid;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: var(--space-sm) var(--space-md);
    padding-bottom: var(--space-xl);
  }
  .step::before {
    content: '';
    position: absolute;
    left: calc(1.75rem - 0.5px);
    top: 3.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--d44-line-strong);
  }
  .step:last-child {
    padding-bottom: 0;
  }
  .step:last-child::before {
    display: none;
  }
  .step__marker {
    grid-row: span 2;
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--d44-peach);
    border-radius: 50%;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 0.95rem;
    color: var(--d44-peach-ink);
    background: var(--d44-paper);
  }
  .step__title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-h3);
    margin-bottom: 0.5rem;
    padding-top: 0.6rem;
  }
  .step__title :global(.icon) {
    color: var(--d44-blue-deep);
    flex-shrink: 0;
  }
  .step__head p {
    max-width: 34rem;
  }
  .step__list {
    grid-column: 2;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--d44-line);
  }
  @media (min-width: 960px) {
    .step {
      grid-template-columns: 3.5rem 1fr 0.8fr;
      gap: var(--space-xl);
    }
    .step__marker {
      grid-row: auto;
    }
    .step__list {
      grid-column: 3;
      border-top: 0;
      border-left: 1px solid var(--d44-line);
      padding: 0.75rem 0 0 var(--space-lg);
    }
  }

  .extras {
    overflow: hidden;
  }
  .extras :global(.extras__lines) {
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--d44-blue);
    opacity: 0.18;
  }
  .extras .container {
    position: relative;
  }
  .extras__grid {
    display: grid;
    border-top: 1px solid var(--d44-line);
  }
  @media (min-width: 760px) {
    .extras__grid {
      grid-template-columns: 1fr 1fr;
    }
    .extra:nth-child(odd) {
      padding-right: var(--space-lg);
      border-right: 1px solid var(--d44-line);
    }
    .extra:nth-child(even) {
      padding-left: var(--space-lg);
    }
  }
  .extra {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--d44-line);
  }
  .extra h3 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-h4);
    margin-bottom: 0.5rem;
  }
  .extra h3 :global(.icon) {
    color: var(--d44-peach-ink);
  }

  .how {
    overflow: hidden;
  }
  .how :global(.how__orbit) {
    width: min(900px, 120%);
    height: auto;
    aspect-ratio: 1;
    left: 50%;
    bottom: -55%;
    transform: translateX(-50%);
    color: var(--d44-blue-logo);
    opacity: 0.18;
  }
  .how__inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .how__inner :global(.section-heading) {
    margin-bottom: var(--space-md);
  }
  .how__text {
    margin-bottom: var(--space-lg);
  }
</style>
